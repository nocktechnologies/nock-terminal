{
  "name": "nock-terminal",
  "version": "1.0.0",
  "description": "Nock Terminal \u2014 local agentic coding cockpit",
  "repository": {
    "type": "git",
    "url": "https://github.com/nocktechnologies/nock-terminal.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev": "vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "test": "node --test",
    "lint": "eslint .",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "release:check": "npm test && npm run lint && npm audit --audit-level=moderate && npx vite build && npm run check:bundle"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "dompurify": "^3.4.13",
    "electron-store": "^8.1.0",
    "highlight.js": "^11.9.0",
    "lucide-react": "^1.7.0",
    "marked": "^9.0.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.0",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.0",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.nock.terminal",
    "productName": "Nock Terminal",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    },
    "files": [
      "electron/**/*",
      "dist-react/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "overrides": {
    "axios": "^1.19.0",
    "dompurify": "^3.4.13"
  },
  "knip": {
    "entry": [
      "src/main.jsx",
      "electron/main.js",
      "electron/preload.js",
      "scripts/*.mjs",
      "test/**/*.test.cjs",
      "test/**/*.test.mjs"
    ]
  }
}
